# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Admin Telegram ID
ADMIN_ID=your_admin_telegram_id

# Employee Telegram IDs (comma separated)
EMPLOYEE_IDS=employee_telegram_id_1,employee_telegram_id_2

# Database
DATABASE_URL=sqlite+aiosqlite:///massage_bot.db

# Salon Info
SALON_NAME=VOLGA SPA
SALON_ADDRESS=Приволжский федеральный округ, Нижегородская область, городской округ Нижний Новгород, Нижний Новгород, Советская улица, 12 этаж 4, офис 436
SALON_PHONE=+7 (987) 530-91-00
SALON_SCHEDULE=вт,чт-сб 8:00-20:00

# Notification settings (hours before appointment)
REMINDER_HOURS=24,3

# Google Gemini API (для AI-ассистента)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
